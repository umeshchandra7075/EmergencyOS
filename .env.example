/**
 * Emergency Route Planner - Environment Configuration
 * ======================================================
 * Notes:
 * - MongoDB Atlas connection string recommended for production
 * - JWT secrets should be strong random values
 * - OSRM server configuration for routing
 * - Nodemailer settings for email notifications (optional)
 */

# =============================================================================
# Database
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/emergency_route_planner

# =============================================================================
# Authentication & Session
# =============================================================================
# JWT access token expiration (15 minutes default)
JWT_EXPIRES_IN=15m
# JWT refresh token expiration (30 days default)
JWT_REFRESH_EXPIRES_IN=30d
# JWT secret for access token signing - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-secure-random-value
# JWT secret for refresh token signing - should be different from JWT_SECRET
JWT_REFRESH_SECRET=change-this-to-a-secure-random-value

# =============================================================================
# Server
# =============================================================================
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# =============================================================================
# Rate Limiting
# =============================================================================
# Rate limit window in milliseconds (15 minutes default)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP
RATE_LIMIT_MAX=100

# =============================================================================
# Cookie Settings
# =============================================================================
# HTTPS only - set to false for development HTTP
COOKIE_SECURE=false # Set to true in production with HTTPS
# JavaScript cannot access httpOnly cookies
COOKIE_HTTP_ONLY=true
# CSRF protection - lax allows cross-origin GET requests, strict does not
COOKIE_SAME_SITE=lax
# Cookie max age in milliseconds (24 hours default)
COOKIE_MAX_AGE=86400000

# =============================================================================
# OSRM Routing Service
# =============================================================================
# OSRM server base URL - using public instance by default
OSRM_BASE_URL=http://router.project-osrm.org/route/v1/driving
# Timeout in milliseconds for OSRM requests
OSRM_TIMEOUT=8000
# Cache TTL in seconds (3600 = 1 hour)
OSRM_CACHE_TTL=3600

# =============================================================================
# Email (Nodemailer - for assignments and notifications)
# =============================================================================
# Transactional email service configuration
EMAIL_FROM=Emergency Route Planner <no-reply@emergency.example>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false # Use TLS
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# =============================================================================
# Security
# =============================================================================
# Argon2id parameters (if using bcrypt-compatible password hashing)
# These are informational - actual hashing uses bcrypt
ARGON2ID_MEM_COST=65536
ARGON2ID_TIME_COST=3
ARGON2ID_PARALLELISM=4

# =============================================================================
# Application Settings
# =============================================================================
# Maximum GPS update frequency (seconds) - throttle to 1 per 3 seconds max
GPS_UPDATE_INTERVAL=3000
# Default route alternatives to return
DEFAULT_ROUTE_ALTERNATIVES=3